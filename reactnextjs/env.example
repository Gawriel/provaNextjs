# Copia questo file in .env.local (nella cartella reactnextjs)

# Formato: mongodb://HOST:PORT/NOME_DATABASE
# Il nome del database sta ALLA FINE del path, dopo la porta.
MONGODB_URI=mongodb://127.0.0.1:27017/cinemaverse

# Oppure MongoDB Atlas:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/cinemaverse

# Debug: basta UNA delle due a true per scrivere i log
DEBUG_ENABLE=true
NEXT_PUBLIC_DEBUG_ENABLE=true

# 1=error, 2=warn, 3=info, 4=verbose (default 4)
DEBUG_LEVEL=4
NEXT_PUBLIC_DEBUG_LEVEL=4

# Oppure MongoDB Atlas:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/cinemaverse

# Debug: basta UNA delle due a true per scrivere i log
DEBUG_ENABLE=true
NEXT_PUBLIC_DEBUG_ENABLE=true

# 1=error, 2=warn, 3=info, 4=verbose (default 4)
DEBUG_LEVEL=4
NEXT_PUBLIC_DEBUG_LEVEL=4

